# Copy this file to .env:  cp .env.sample .env
# Values marked "CHANGE" must be replaced for the feature to work.
# Everything else already works both in Docker and in a local run.

# --- Django ---------------------------------------------------------------
# CHANGE: any long random string (keep it secret)
SECRET_KEY=change-me-to-a-long-random-string
# True is required to serve car photos (/media/) with the dev server
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL -----------------------------------------------------------
# Docker: empty POSTGRES_DB means the database "car_rental" in the db container.
# Local run: empty means SQLite; set it only if you run your own PostgreSQL.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis and Celery (local run only, Docker sets its own addresses) ------
# Empty REDIS_URL: cache in memory. Set redis://localhost:6379/1 if Redis runs.
REDIS_URL=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# --- Stripe payments ------------------------------------------------------
# CHANGE: secret key from https://dashboard.stripe.com/test/apikeys (sk_test_...)
STRIPE_API=
# CHANGE: signing secret printed by `stripe listen` (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the user after checkout
FRONTEND_URL=http://localhost:5173
# Used only when FRONTEND_URL is empty (redirect to the API)
SITE_URL=http://localhost:8000

# --- Telegram notifications -----------------------------------------------
# CHANGE: bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# CHANGE: chat id that receives notifications
TELEGRAM_CHAT_ID=
